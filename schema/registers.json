{
    "$schema": "https://json-schema.org/draft-07/schema",
    "$id": "https://harp-tech.org/draft-03/schema/registers.json",
    "type": "object",
    "properties": {
        "description": {
            "description": "Specifies a summary description of the register interface.",
            "type": "string",
            "pattern": "^(?![\\s\\S]*[\\r\\n])",
            "patternErrorMessage": "Must be a single line."
        },
        "registers": {
            "type": "object",
            "description": "Specifies the collection of registers implementing the device function.",
            "patternProperties": {
                "^Reserved[0-9]+$": { "$ref": "#/definitions/reservedRegister" }
            },
            "additionalProperties": { "$ref": "#/definitions/register" }
        },
        "bitMasks": {
            "type": "object",
            "description": "Specifies the collection of masks available to be used with the different registers.",
            "additionalProperties": { "$ref": "#/definitions/bitMask" }
        },
        "groupMasks": {
            "type": "object",
            "description": "Specifies the collection of group masks available to be used with the different registers.",
            "additionalProperties": { "$ref": "#/definitions/groupMask" }
        }
    },
    "required": ["registers"],
    "definitions": {
        "type": {
            "description": "Specifies the type of the register payload.",
            "type": "string",
            "enum": ["U8", "S8", "U16", "S16", "U32", "S32", "U64", "S64", "Float"],
            "enumDescriptions": [
                "8-bit unsigned integer.",
                "8-bit signed integer.",
                "16-bit unsigned integer.",
                "16-bit signed integer.",
                "32-bit unsigned integer.",
                "32-bit signed integer.",
                "64-bit unsigned integer.",
                "64-bit signed integer.",
                "32-bit IEEE 754 floating-point number."
            ]
        },
        "maskValue": {
            "oneOf": [
                { "type": "integer" },
                {
                    "type": "object",
                    "properties": {
                        "value": {
                            "description": "Specifies the numerical mask value.",
                            "type": "integer"
                        },
                        "description": {
                            "description": "Specifies a summary description of the mask value function.",
                            "type": "string",
                            "pattern": "^(?![\\s\\S]*[\\r\\n])",
                            "patternErrorMessage": "Must be a single line."
                        }
                    },
                    "required": ["value"],
                    "additionalProperties": false
                }
            ]
        },
        "bitMask": {
            "description": "Specifies a bit mask used for reading or writing specific registers.",
            "type": "object",
            "properties": {
                "description": {
                    "description": "Specifies a summary description of the bit mask function.",
                    "type": "string",
                    "pattern": "^(?![\\s\\S]*[\\r\\n])",
                    "patternErrorMessage": "Must be a single line."
                },
                "bits": {
                    "description": "Specifies the single-bit flags of the bit mask.",
                    "type": "object",
                    "additionalProperties": { "$ref": "#/definitions/maskValue" }
                }
            },
            "required": ["bits"]
        },
        "groupMask": {
            "description": "Specifies a group mask used for reading or writing specific registers.",
            "type": "object",
            "properties": {
                "description": {
                    "description": "Specifies a summary description of the group mask function.",
                    "type": "string",
                    "pattern": "^(?![\\s\\S]*[\\r\\n])",
                    "patternErrorMessage": "Must be a single line."
                },
                "values": {
                    "description": "Specifies the mutually exclusive values of the group mask.",
                    "type": "object",
                    "additionalProperties": { "$ref": "#/definitions/maskValue" }
                }
            },
            "required": ["values"]
        },
        "maskType": {
            "description": "Specifies the name of the bit mask or group mask used to represent the value.",
            "type": "string"
        },
        "interfaceType": {
            "description": "Specifies the name of the type used to represent the value in the high-level interface. The suggested names are built-in types.",
            "type": "string",
            "anyOf": [
                { "const": "bool", "description": "Boolean value, from a single element." },
                { "const": "byte", "description": "8-bit unsigned integer, the same as payload type U8." },
                { "const": "sbyte", "description": "8-bit signed integer, the same as payload type S8." },
                { "const": "ushort", "description": "16-bit unsigned integer, the same as payload type U16." },
                { "const": "short", "description": "16-bit signed integer, the same as payload type S16." },
                { "const": "uint", "description": "32-bit unsigned integer, the same as payload type U32." },
                { "const": "int", "description": "32-bit signed integer, the same as payload type S32." },
                { "const": "ulong", "description": "64-bit unsigned integer, the same as payload type U64." },
                { "const": "long", "description": "64-bit signed integer, the same as payload type S64." },
                { "const": "float", "description": "32-bit IEEE 754 floating-point number, the same as payload type Float." },
                { "const": "string", "description": "UTF-8 text of up to the declared length in bytes, from U8 elements." },
                { "const": "HarpVersion", "description": "Major, minor and patch version numbers, one byte each." },
                { "description": "Custom type, declared in the device interface or supplied by a converter." }
            ]
        },
        "converter": {
            "description": "Specifies whether a custom converter will be used to parse or format the value.",
            "type": "string",
            "enum": ["None", "Payload", "RawPayload"],
            "enumDescriptions": [
                "No custom converter is used.",
                "A custom converter operates on the payload, as values of the register type.",
                "A custom converter operates on the raw payload bytes."
            ]
        },
        "minValue": {
            "description": "Specifies the minimum allowable value.",
            "type": "number"
        },
        "maxValue": {
            "description": "Specifies the maximum allowable value.",
            "type": "number"
        },
        "defaultValue": {
            "description": "Specifies the default value.",
            "type": "number"
        },
        "payloadMember": {
            "type": "object",
            "properties": {
                "mask": {
                    "description": "Specifies the mask used to read and write this payload member.",
                    "type": "integer"
                },
                "offset": {
                    "description": "Specifies the zero-based index at which encoding of this payload member starts.",
                    "type": "integer"
                },
                "length": {
                    "description": "Specifies the number of elements used to encode this payload member.",
                    "type": "integer",
                    "minimum": 1
                },
                "description": {
                    "description": "Specifies a summary description of the payload member.",
                    "type": "string",
                    "pattern": "^(?![\\s\\S]*[\\r\\n])",
                    "patternErrorMessage": "Must be a single line."
                },
                "deprecated": {
                    "description": "Specifies whether the payload member is deprecated.",
                    "type": "boolean"
                },
                "minValue": { "$ref": "#/definitions/minValue" },
                "maxValue": { "$ref": "#/definitions/maxValue" },
                "defaultValue": { "$ref": "#/definitions/defaultValue" },
                "maskType": { "$ref": "#/definitions/maskType" },
                "interfaceType": { "$ref": "#/definitions/interfaceType" },
                "converter": { "$ref": "#/definitions/converter" }
            }
        },
        "register": {
            "type": "object",
            "properties": {
                "address": {
                    "description": "Specifies the unique 8-bit address of the register.",
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                },
                "type": { "$ref": "#/definitions/type" },
                "length": {
                    "description": "Specifies the number of payload elements, or a single element if omitted.",
                    "type": "integer",
                    "minimum": 1
                },
                "read": {
                    "description": "Specifies whether the register can be read.",
                    "type": "boolean",
                    "default": true
                },
                "write": {
                    "description": "Specifies whether the register can be written.",
                    "type": "boolean",
                    "default": false
                },
                "event": {
                    "description": "Specifies whether the register reports its contents in event messages.",
                    "type": "boolean",
                    "default": false
                },
                "description": {
                    "description": "Specifies a summary description of the register function.",
                    "type": "string",
                    "pattern": "^(?![\\s\\S]*[\\r\\n])",
                    "patternErrorMessage": "Must be a single line."
                },
                "minValue": { "$ref": "#/definitions/minValue" },
                "maxValue": { "$ref": "#/definitions/maxValue" },
                "defaultValue": { "$ref": "#/definitions/defaultValue" },
                "maskType": { "$ref": "#/definitions/maskType" },
                "visibility": {
                    "description": "Specifies whether the register function is exposed in the high-level interface.",
                    "type": "string",
                    "enum": ["public", "private"],
                    "enumDescriptions": [
                        "The register is exposed in the high-level interface.",
                        "The register is hidden from the high-level interface."
                    ]
                },
                "deprecated": {
                    "description": "Specifies whether the register function is deprecated.",
                    "type": "boolean"
                },
                "volatile": {
                    "description": "Specifies whether register values can be saved in non-volatile memory.",
                    "type": "boolean"
                },
                "payloadSpec": {
                    "description": "Specifies the members of the register payload.",
                    "type": "object",
                    "additionalProperties": { "$ref": "#/definitions/payloadMember" }
                },
                "interfaceType": { "$ref": "#/definitions/interfaceType" },
                "converter": { "$ref": "#/definitions/converter" }
            },
            "required": ["address", "type"],
            "if": {
                "properties": { "read": { "const": false } },
                "required": ["read"]
            },
            "then": {
                "anyOf": [
                    { "properties": { "write": { "const": true } }, "required": ["write"] },
                    { "properties": { "event": { "const": true } }, "required": ["event"] }
                ]
            }
        },
        "reservedRegister": {
            "description": "Specifies a register reserved for future use.",
            "type": "object",
            "properties": {
                "address": { "$ref": "#/definitions/register/properties/address" },
                "visibility": {
                    "description": "Specifies that the register is reserved.",
                    "const": "reserved"
                },
                "type": {
                    "allOf": [{ "$ref": "#/definitions/type" }],
                    "default": "U8"
                },
                "length": { "$ref": "#/definitions/register/properties/length" },
                "read": {
                    "description": "Specifies that the reserved register can be read.",
                    "const": true,
                    "default": true
                },
                "description": {
                    "description": "Specifies a summary description of the reserved register.",
                    "type": "string",
                    "pattern": "^(?![\\s\\S]*[\\r\\n])",
                    "patternErrorMessage": "Must be a single line.",
                    "default": "Reserved for future use."
                }
            },
            "required": ["address", "visibility"],
            "additionalProperties": false
        }
    }
}